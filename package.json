{
  "name": "tgstation-bt-editor",
  "displayName": "tgstation BT Editor",
  "description": "Visual behavior tree editor for tgstation DM files",
  "version": "0.1.0",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CabinetOnFire/BehaviorTreeG"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:dm",
    "onLanguage:json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "btEditor.visualEditor",
        "displayName": "BT Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.bt.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "bt-editor.open",
        "title": "Open BT Editor",
        "icon": "$(symbol-event)"
      },
      {
        "command": "bt-editor.deploy-all",
        "title": "Deploy all BT JSONs to DM",
        "icon": "$(cloud-upload)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bt-editor-activitybar",
          "title": "BT Editor",
          "icon": "media/bt-icon.svg"
        }
      ]
    },
    "views": {
      "bt-editor-activitybar": [
        {
          "id": "bt-editor.treeView",
          "name": "Behavior Trees",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bt-editor.treeView",
        "contents": "Open a .bt.json or .dm file to get started.\n[Open BT Editor](command:bt-editor.open)"
      }
    ],
    "configuration": {
      "title": "BT Editor",
      "properties": {
        "btEditor.outputDirectory": {
          "type": "string",
          "default": "code/_generated/behavior_trees",
          "description": "Workspace-relative path where generated .dm files are written during deploy. Example: \"code/_generated/behavior_trees\""
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "bt-editor.open",
          "when": "resourceLangId == dm || resourceExtname == .bt.json",
          "group": "navigation"
        },
        {
          "command": "bt-editor.deploy-all",
          "when": "resourceExtname == .bt.json",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "bt-editor.open",
          "when": "view == bt-editor.treeView && (resourceLangId == dm || resourceExtname == .bt.json)",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node .esbuild.config.js",
    "watch": "node .esbuild.config.js --watch",
    "test": "jest",
    "lint": "eslint src media/editor shared --ext .ts,.tsx",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@xyflow/react": "^12.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  }
}
